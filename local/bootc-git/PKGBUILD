
pkgname=bootc-git
_pkgname=bootc
# Match current source so makepkg preserves the metadata-only release bump.
pkgver=1.16.14.r70.g66d4e4d
pkgrel=3
pkgdesc="Boot and upgrade via container images"
arch=('x86_64' 'i686' 'armv6h' 'armv7h')
url="https://bootc-dev.github.io/bootc"
_url="https://www.github.com/$_pkgname-dev/$_pkgname"
license=('MIT OR Apache-2.0')
# Current bootc links libselinux unconditionally, including during doc generation.
depends=(gcc-libs
  glibc
  libselinux
  ostree
  systemd)
# selinux-sys uses bindgen and needs libclang at build time.
makedepends=(cargo
  clang
  git
  make
  go-md2man)
provides=("bootc=$pkgver")
conflicts=('bootc')
source=("git+$_url.git")
sha256sums=('SKIP')
# options=(!lto)

prepare() {
  cd "$_pkgname"
  cargo fetch --target "$(rustc -vV | sed -n 's/host: //p')"
}

pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 --match="v*" HEAD |
    sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  
  # Build binaries and man pages
  make bin manpages
}

package() {
  cd "$_pkgname"
  
  # Use Makefile for complete installation
  # Includes: binaries, systemd units, man pages, config files, etc.
  make install DESTDIR="${pkgdir}" prefix=/usr
  
  # Install ostree integration hooks (optional but recommended)
  make install-ostree-hooks DESTDIR="${pkgdir}" prefix=/usr
  # Arch builds ostree with --libexecdir=/usr/lib. Keep upstream's hooks,
  # but put them in Arch's lookup path; the relative link depth is unchanged.
  install -dm755 "${pkgdir}/usr/lib/libostree"
  mv "${pkgdir}/usr/libexec/libostree/ext" "${pkgdir}/usr/lib/libostree/"
  rmdir --ignore-fail-on-non-empty "${pkgdir}/usr/libexec/libostree" "${pkgdir}/usr/libexec"
}
