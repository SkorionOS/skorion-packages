+}
+
 static struct kmscon_text_ops dummy_ops = {
 	.name = "dummytest",
 	.owner = NULL,
@@ -43,7 +54,48 @@
 	.destroy = NULL,
 	.set = dummy_set,
 	.unset = dummy_unset,
+	.rotate = dummy_rotate,
 };
+
+static void test_panel_orientation(void)
+{
+	static const char *rotations[] = {"normal", "right", "upside-down", "left"};
+	struct display *disp = (struct display *)0x1; /* opaque to the stubs */
+	struct kmscon_font font = {0}, other_font = {0};
+	struct kmscon_text *txt;
+	unsigned int p, u, effective, turn;
+
+	assert(kmscon_text_register(&dummy_ops) == 0);
+	for (p = 0; p < 4; p++) {
+		panel = p;
+		for (u = 0; u < 4; u++) {
+			/* An unknown backend exercises the fallback constructor too. */
+			assert(kmscon_text_new(&txt, "missing", rotations[u], disp) == 0);
+			effective = (p + u) % 4;
+			assert(kmscon_text_get_orientation(txt) == effective);
+			/* Font sizing happens before set() in 10.0. */
+			assert(kmscon_text_get_width(txt) == (effective % 2 ? 480 : 800));
+			assert(kmscon_text_get_height(txt) == (effective % 2 ? 800 : 480));
+			assert(kmscon_text_set(txt, &font) == 0);
+			assert(kmscon_text_set(txt, &font) == 0);
+			assert(kmscon_text_set(txt, &other_font) == 0);
+			assert(kmscon_text_get_orientation(txt) == effective);
+			for (turn = 0; turn < 4; turn++) {
+				effective = (effective + 1) % 4;
+				assert(kmscon_text_rotate(txt, effective) == 0);
+				kmscon_text_unset(txt);
+				assert(kmscon_text_set(txt, &font) == 0);
+				assert(kmscon_text_get_orientation(txt) == effective);
+			}
+			kmscon_text_unref(txt);
+		}
+		assert(kmscon_text_new(&txt, NULL, NULL, disp) == 0);
+		assert(kmscon_text_get_orientation(txt) == p);
+		kmscon_text_unref(txt);
+	}
+	kmscon_text_unregister(dummy_ops.name);
+	assert(kmscon_text_rotate(NULL, OR_NORMAL) == -EINVAL);
+}
 
 int main(void)
 {
@@ -72,5 +124,7 @@
 	assert(ret == -EINVAL);
 	assert(dummy_set_calls == 1); /* not called again */
 
+	test_panel_orientation();
+
 	return 0;
 }
