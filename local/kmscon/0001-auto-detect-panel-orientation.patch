diff --git a/tests/test_text.c b/tests/test_text.c
--- a/tests/test_text.c
+++ b/tests/test_text.c
@@ -15,13 +15,18 @@
 void kmscon_font_unref(struct kmscon_font *font) {}
 void display_ref(struct display *disp) {}
 void display_unref(struct display *disp) {}
