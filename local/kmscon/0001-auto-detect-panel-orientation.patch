+/* Missing optional properties are harmless; a failed atomic add is not. */
+static int set_drm_object_property_optional(drmModeAtomicReq *req, struct drm_object *obj,
+					    const char *name, uint64_t value)
+{
+	unsigned int i;
+
+	if (!obj->props)
+		return -EINVAL;
+
+	for (i = 0; i < obj->props->count_props; i++) {
+		if (obj->props_info[i] && !strcmp(obj->props_info[i]->name, name))
+			return drmModeAtomicAddProperty(req, obj->id,
+						obj->props_info[i]->prop_id, value);
+	}
+
+	return 0;
+}
+
 static bool is_crtc_in_use(struct video *video, uint32_t crtc_id)
 {
 	struct display *disp;
@@ -609,6 +627,12 @@
 	if (set_drm_object_property(req, plane, "CRTC_W", width) < 0)
 		return -1;
 	if (set_drm_object_property(req, plane, "CRTC_H", height) < 0)
+		return -1;
+
+	/* A previous VT owner may leave hardware rotation enabled. kmscon rotates
+	 * in software, so reset the primary plane on every atomic commit. Drivers
+	 * without this optional property and the legacy path remain supported. */
+	if (set_drm_object_property_optional(req, plane, "rotation", DRM_MODE_ROTATE_0) < 0)
 		return -1;
 
 	if (ddrm->damage_blob_id) {
@@ -1332,6 +1356,48 @@
 	return mode->hdisplay == 0;
 }
 
+/* Kernel enum values are not clockwise quarter turns; match enum names. */
+static enum panel_orientation read_panel_orientation(int fd, drmModeConnector *conn)
+{
+	drmModePropertyPtr prop;
+	enum panel_orientation result = PANEL_ORIENTATION_NORMAL;
+	int i, j;
+
+	if (!conn)
+		return result;
+
+	for (i = 0; i < conn->count_props; i++) {
+		prop = drmModeGetProperty(fd, conn->props[i]);
+		if (!prop)
+			continue;
+		if (strcmp(prop->name, "panel orientation")) {
+			drmModeFreeProperty(prop);
+			continue;
+		}
+
+		for (j = 0; j < prop->count_enums; j++) {
+			if (prop->enums[j].value != conn->prop_values[i])
+				continue;
+			if (!strcmp(prop->enums[j].name, "Upside Down"))
+				result = PANEL_ORIENTATION_UPSIDE_DOWN;
+			else if (!strcmp(prop->enums[j].name, "Left Side Up"))
+				result = PANEL_ORIENTATION_LEFT;
+			else if (!strcmp(prop->enums[j].name, "Right Side Up"))
+				result = PANEL_ORIENTATION_RIGHT;
+			/* Normal and unknown enum names keep the safe default. */
+			break;
+		}
+		drmModeFreeProperty(prop);
+		break;
+	}
+
+	if (result != PANEL_ORIENTATION_NORMAL)
+		log_info("connector %u panel correction: %u clockwise quarter turns",
+			 conn->connector_id, (unsigned int)result);
+
+	return result;
+}
+
 static void init_modes(struct display *disp, drmModeConnector *conn)
 {
 	struct video *video = disp->video;
@@ -1396,6 +1462,7 @@
 
 	ddrm->connector.id = conn->connector_id;
 	disp->dpms = drm_get_dpms(vdrm->fd, conn);
+	disp->panel_orientation = read_panel_orientation(vdrm->fd, conn);
 	log_info("display %s DPMS is %s", disp->name, dpms_to_name(disp->dpms));
 
 	/* find a crtc for this connector */
