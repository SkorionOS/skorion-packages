pkgname=kmscon
pkgver=10.0.4
pkgrel=1
pkgdesc='Kernel Mode Setting (KMS) and DRM based virtual Console Emulator'
arch=('x86_64')
url='https://github.com/kmscon/kmscon'
license=('MIT')
backup=('etc/kmscon/kmscon.conf')
depends=(
  bash
  dbus
  glib2
  glibc
  libdrm
  'libtsm>=4.8.0'
  "kmscon-terminfo>=$pkgver"
  libxkbcommon
  systemd-libs
  zlib
)
makedepends=(
  check
  docbook-xsl
  freetype2
  git
  libxslt
  linux-api-headers
  libglvnd
  meson
  pango
)
optdepends=(
  'fontconfig: for freetype font rendering'
  'inotify-tools: for kmscon-launch-gui waiting mechanism'
  'libglvnd: for accelerated video output'
  'libx11: for XKB compose support'
  'pango: for pango font rendering'
)
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "0001-auto-detect-panel-orientation.patch"
)
sha256sums=('6918c748c26e9c8cfe81783400be3732792a73e532d6235f40c4b332ca4fde0b'
            '567a0adfcdd1ef6a8b02a6d8de173b991a115cf553458c7dd55e4537eedb67c4')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  patch --batch --forward --fuzz=0 -p1 < "$srcdir/0001-auto-detect-panel-orientation.patch"
}

build() {
  arch-meson "$pkgname-$pkgver" build \
    --wrap-mode=nofallback \
    -Ddbus=enabled \
    -Dtests=true
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir="$pkgdir"
  install -Dm644 "$pkgname-$pkgver/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
  # Arch's split package owns these files. Keep TERM=kmscon functional through
  # the runtime dependency without colliding with an installed kmscon-terminfo.
  rm -r "$pkgdir/usr/share/terminfo"
}
