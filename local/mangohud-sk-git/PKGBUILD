_pkgname=MangoHud
pkgname=mangohud-sk-git
pkgver=0.8.3.r114.ge5ff6e0
pkgrel=1
pkgdesc="A Vulkan overlay layer for monitoring FPS, temperatures, CPU/GPU load and more"
url='https://github.com/honjow/MangoHud'
license=('MIT')
arch=('x86_64')
makedepends=(
    'appstream'
    'cmocka'
    'dbus'
    'git'
    'glslang'
    'libxnvctrl'
    'libxrandr'
    'meson'
    'nlohmann-json'
    'python-mako'
    'vulkan-headers'
    'vulkan-icd-loader'
    'wayland-protocols'
    'yaml-cpp'
)
depends=(
    'gcc-libs'
    'glew'
    'glfw'
    'glibc'
    'hicolor-icon-theme'
    'libcap'
    'libdrm'
    'libglvnd'
    'libx11'
    'libxi'
    'libxkbcommon'
    'mesa'
    'python'
    'python-matplotlib'
    'python-numpy'
    'sh'
    'systemd-libs'
    'vulkan-icd-loader'
    'wayland'
    'yaml-cpp'
)
optdepends=(
    'dbus: mangohudctl'
    'libxnvctrl: NVIDIA GPU metrics on older GPUs'
)
provides=('mangohud' 'mangoapp')
replaces=('mangoapp')
conflicts=('mangohud' 'mangohud-common-git' 'mangoapp' 'mangohud-git')
# _commit=9ebc85dfd1730a95f0334bf14151a02859aa9f97
source=(
    "$_pkgname::git+$url#commit=305a576c7a63a546a0727f0b82fd08c1bdbf2eef"
    )
sha256sums=('SKIP')

pkgver() {
    cd $_pkgname
    git describe --tags --long --abbrev=7 | sed 's/^v//;s/-rc[0-9]\+-/-/;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    cd ${srcdir}/${_pkgname}

    local src
    for src in "${source[@]}"; do
        [[ $src = *.patch ]] || continue
        patch -p1 < "${srcdir}"/$src
    done
}

build() {
    arch-meson "$_pkgname" build \
        -Dmangoapp=true \
        -Dmangohudctl=true \
        --wrap-mode=default

    meson compile -C build
}

package() {
    meson install -C build --destdir "$pkgdir"

    install -Dm 0644 "$_pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}

# Candidate-PR-only verification. Do not include in the production recipe update.
check() {
    local test_status=0
    cd "$srcdir"

    python - build/meson-info/intro-tests.json <<'PY' || return 1
import json, pathlib, sys
expected = {
    "platform-sensors", "battery-fixtures", "intel-fallbacks",
    "intel-drm-resources", "gpu-lifetime", "validate metainfo file",
}
tests = json.loads(pathlib.Path(sys.argv[1]).read_text())
names = [test["name"] for test in tests]
print("Candidate Meson suites:", ", ".join(sorted(names)), flush=True)
if len(tests) != 6 or set(names) != expected:
    raise SystemExit(f"Expected the five candidate suites plus the existing metainfo validation; found {names!r}")
PY

    meson test -C build --no-rebuild --print-errorlogs || test_status=$?

    # Print useful, verifiable test evidence without dumping Meson's environment.
    python - build/meson-logs/testlog.json <<'PY' || return 1
import json, pathlib, sys
expected = {
    "platform-sensors", "battery-fixtures", "intel-fallbacks",
    "intel-drm-resources", "gpu-lifetime", "validate metainfo file",
}
results = [json.loads(line) for line in pathlib.Path(sys.argv[1]).read_text().splitlines() if line.strip()]
for result in results:
    print(json.dumps({key: result.get(key) for key in
                     ("name", "result", "returncode", "duration", "stdout", "stderr")},
                     ensure_ascii=False), flush=True)
names = [result["name"].split(" / ")[-1].rsplit(":", 1)[-1] for result in results]
if len(results) != 6 or set(names) != expected:
    raise SystemExit(f"Expected results for all six registered tests; found {names!r}")
if any(result.get("result") != "OK" or result.get("returncode") != 0 for result in results):
    raise SystemExit("All six tests must pass; skips, expected failures and nonzero exits are rejected")
print("Candidate test gate: 5/5 fixture suites + 1/1 existing metainfo validation PASS", flush=True)
PY

    return "$test_status"
}
