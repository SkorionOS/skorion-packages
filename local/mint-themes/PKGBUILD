# Maintainer: Sam Burgos <santiago.burgos1089@gmail.com>

pkgname=mint-themes
pkgver=2.4.2
pkgrel=1
pkgdesc='A collection of Mint themes.'
arch=('any')
url="https://github.com/linuxmint/mint-themes"
license=('GPL-3.0-or-later')
depends=(
    'ttf-ubuntu-font-family'
)
makedepends=(
    'python-libsass'
)
optdepends=(
    'mint-x-icons'
    'mint-y-icons'
)
options=('!strip')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('8dccea7534986857ab1358f45edd42022bbbc20fde78865df649e98a7427103d')

build() {
    cd "$pkgname-$pkgver"
    make clean
    make
}

package() {
    cd "$pkgname-$pkgver"
    # Keep upstream symlinks, rather than copying their targets.
    cp -a usr "$pkgdir/"
}
