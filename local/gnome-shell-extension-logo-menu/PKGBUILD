# Based on the AUR recipe by getzze.
pkgname=gnome-shell-extension-logo-menu
pkgver=25.2_280926
pkgrel=1
pkgdesc='Quick access menu for the GNOME panel'
arch=('any')
url='https://github.com/Aryan20/Logomenu'
license=('GPL-2.0-or-later')
# The unmodified upstream metadata declares GNOME Shell 49, 50 and 51.
# Arch's gnome-shell package uses epoch 1; both bounds must include it.
depends=('gnome-shell>=1:49' 'gnome-shell<1:52')
makedepends=('gettext' 'glib2' 'unzip')
source=("Logomenu-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('7897b12ebf32c2d323e20430589b08136e61138b096c38b7208cdc31efbab592')

build() {
    cd "${srcdir}/Logomenu-${pkgver}"
    make build
}

package() {
    cd "${srcdir}/Logomenu-${pkgver}"
    local _uuid=logomenu@aryan_k
    local _destdir="${pkgdir}/usr/share/gnome-shell/extensions/${_uuid}"
    install -d "${_destdir}"
    unzip -q "${_uuid}.shell-extension.zip" -d "${_destdir}"

    # Use the system schema directory and pacman's normal schema compile hook.
    install -d "${pkgdir}/usr/share/glib-2.0"
    mv "${_destdir}/schemas" "${pkgdir}/usr/share/glib-2.0/"
    rm -f "${pkgdir}/usr/share/glib-2.0/schemas/gschemas.compiled"
    mv "${_destdir}/locale" "${pkgdir}/usr/share/"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
